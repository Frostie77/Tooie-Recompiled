<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <provider
            android:name="io.github.banjotooierecompiled.StartupLogProvider"
            android:authorities="${applicationId}.startup-logs"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name="io.github.banjotooierecompiled.BanjoTooieGameActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:process=":game"
            android:taskAffinity="${applicationId}.game"
            android:hardwareAccelerated="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="landscape" />
        <activity
            android:name="io.github.banjotooierecompiled.GraphicsDriverActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.drivers"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:hardwareAccelerated="false"
            android:theme="@style/DriverSettingsTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.banjotooierecompiled.GraphicsDriverSettingsActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.drivers"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:hardwareAccelerated="false"
            android:theme="@style/DriverSettingsTheme" />
        <!-- Keep existing ES-DE/shortcut/adb components working through the
             pre-Vulkan router. This alias adds no duplicate launcher icon. -->
        <activity-alias
            android:name="io.github.banjotooierecompiled.BanjoTooieSDLActivity"
            android:targetActivity="io.github.banjotooierecompiled.GraphicsDriverActivity"
            android:exported="true"
            android:enabled="true" />
    </application>
</manifest>
