#version 450
#extension GL_EXT_nonuniform_qualifier : require
layout(local_size_x=1) in;
// Match RT64's real common and runtime texture layouts, including its immutable
// nearest sampler. Only the selected array element is initialized/accessed.
layout(set=0,binding=24) uniform sampler nearestSampler;
layout(set=1,binding=0) uniform texture2D textures[];
layout(set=2,binding=0,rgba8) uniform writeonly image2D resultImage;
layout(push_constant) uniform Index { uint selected; } pc;
void main() {
    imageStore(resultImage,ivec2(0),textureLod(sampler2D(textures[pc.selected],nearestSampler),vec2(0.5),0));
}
