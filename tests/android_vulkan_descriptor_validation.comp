#version 450
layout(local_size_x=1, local_size_y=1) in;
layout(set=0,binding=1) uniform samplerBuffer floatInput;
layout(set=0,binding=2) uniform usamplerBuffer byteInput;
layout(set=0,binding=3) uniform isamplerBuffer signedInput;
layout(set=0,binding=4) uniform usamplerBuffer shortInput;
layout(set=0,binding=5,std140) uniform Params { uvec4 increment; } params;
layout(set=0,binding=6,std430) readonly buffer Structured { uint values[]; } structured;
layout(set=0,binding=7,std430) writeonly buffer Output { uvec4 values[]; } outputData;
layout(set=1,binding=1) uniform texture2D sourceColor;
layout(set=1,binding=2) uniform sampler colorSampler;
layout(set=1,binding=3,rgba8) uniform writeonly image2D destination;
void main() {
 uint i=gl_GlobalInvocationID.x;
 outputData.values[i]=uvec4(floatBitsToUint(texelFetch(floatInput,int(i)).x),
   texelFetch(byteInput,int(i)).x+params.increment.x,
   uint(texelFetch(signedInput,int(i)).x+128),texelFetch(shortInput,int(i)).x+structured.values[0]);
 imageStore(destination,ivec2(i,0),texelFetch(sampler2D(sourceColor,colorSampler),ivec2(i,0),0));
}
